DATABASE_URL="postgresql://radar:radar_local_only@127.0.0.1:5432/radar?schema=public"
TEST_DATABASE_URL="postgresql://radar:radar_local_only@127.0.0.1:5432/radar_test?schema=public"
POSTGRES_PASSWORD="radar_local_only"
AI_MODE="DEMO"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL=""
# Optional server-only token for legacy source/admin mutation endpoints. Never expose in browser.
OPERATIONS_ADMIN_TOKEN=""
# Personal news pipeline: server-only provider settings, never NEXT_PUBLIC_*.
NEWS_AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# Optional Groq configuration when NEWS_AI_PROVIDER=groq.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
# One server polling loop; prepared demo data is opt-in for isolated checks only.
RADAR_SYNC_ENABLED="true"
RADAR_DEMO_MODE="false"
# Server-side reverse geocoding, triggered only by selecting a business point.
GEOCODING_BASE_URL="https://nominatim.openstreetmap.org"
